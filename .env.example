# =============================================================================
# DATABASE
# =============================================================================
# Local development: local Postgres via docker-compose (npm run db:up).
#   DATABASE_URL="postgresql://crdph:crdph@localhost:5432/crdph?schema=public"
#   DIRECT_URL="postgresql://crdph:crdph@localhost:5432/crdph?schema=public"
#
# Production (Vercel + Supabase): create a Supabase project, then use its
# TWO connection strings (Project Settings -> Database -> Connection string):
#   DATABASE_URL = the "Transaction" pooler string, port 6543, with
#                   ?pgbouncer=true appended — required for serverless
#                   functions (many short-lived connections).
#   DIRECT_URL   = the "Session"/direct string, port 5432, no pgbouncer —
#                   required for `prisma migrate deploy`.
#
# Set these as separate values per Vercel Environment (Development / Preview
# / Production) in the Vercel dashboard — do NOT put production credentials
# in this file or commit a filled-in .env.
DATABASE_URL="postgresql://crdph:crdph@localhost:5432/crdph?schema=public"
DIRECT_URL="postgresql://crdph:crdph@localhost:5432/crdph?schema=public"

# =============================================================================
# SITE
# =============================================================================
NEXT_PUBLIC_SITE_URL="https://crdph.org"

# =============================================================================
# AUTH (CMS at /admin)
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# =============================================================================
# EMAIL (contact form + notifications)
# =============================================================================
RESEND_API_KEY=""
CONTACT_INBOX_EMAIL="info@crdph.org"

# =============================================================================
# PAYMENTS (/pay page — invoices & engagement deposits)
# =============================================================================
# Stripe: test mode works immediately with a sk_test_... key from the Stripe dashboard.
# Swap for a sk_live_... key (and add a webhook handler) when ready to go live.
STRIPE_SECRET_KEY=""
# PayPal: use a Sandbox Client ID from developer.paypal.com to test; swap for
# a Live Client ID when ready. This is a public/client-side key (NEXT_PUBLIC_).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# =============================================================================
# CLOUDINARY (image + file uploads across the whole app — gallery, homepage
# banners, blog cover images, and downloadable resources/PDFs)
# =============================================================================
# From your Cloudinary dashboard (cloudinary.com/console) -> Account Details.
# CLOUD_NAME is not secret and is also exposed to the browser (the upload
# widget needs it client-side); API_KEY/API_SECRET stay server-only and are
# used to sign uploads via /api/cloudinary/sign so the secret never reaches
# the browser.
CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
# Same value as CLOUDINARY_API_KEY. The API *key* is public by design (the signed-upload
# widget needs it in the browser); only the API *secret* must stay server-side.
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =============================================================================
# SEED SCRIPT (first admin CMS account + sample content)
# =============================================================================
SEED_ADMIN_EMAIL="admin@crdph.org"
SEED_ADMIN_PASSWORD="change-me-immediately"

# =============================================================================
# MIGRATION (see /migration-scripts) — only needed while migrating legacy data
# =============================================================================
EXPORT_DIR="./export"
